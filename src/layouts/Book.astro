---
import '../styles/fonts.generated.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/rtl.css';
import '../styles/figures.css';
import '../styles/figures-extra.css';
import '../styles/context.css';
import '../styles/print.css';
import ProgressRail from '../components/shell/ProgressRail.astro';
import TocDrawer from '../components/shell/TocDrawer.astro';
import type { PartMeta, LessonMeta } from '../data/lessons';

interface Props {
  parts: PartMeta[];
  lessons: LessonMeta[];
}

const { parts, lessons } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>هوش مصنوعی؛ از شناخت تا کاربرد</title>
    <meta
      name="description"
      content="یک سند فارسی تعاملی که هوش مصنوعی را از بالا به پایین برای مدیران و خوانندگان غیرفنی توضیح می‌دهد."
    />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>

    <svg class="icon-sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
      <defs>
        <symbol id="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>
        </symbol>
        <symbol id="icon-bot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="7" width="16" height="12" rx="3"></rect><path d="M12 3v4M8 13h.01M16 13h.01M9 17h6"></path>
        </symbol>
        <symbol id="icon-model" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 3 8l9 5 9-5-9-5Z"></path><path d="m3 12 9 5 9-5M3 16l9 5 9-5"></path>
        </symbol>
        <symbol id="icon-tool" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="m14 6 4-4 4 4-4 4"></path><path d="M17 3 8 12l-4 8 8-4 9-9"></path>
        </symbol>
        <symbol id="icon-database" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"></path>
        </symbol>
        <symbol id="icon-document" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2h8l5 5v15H6z"></path><path d="M14 2v6h5M9 13h6M9 17h6"></path>
        </symbol>
        <symbol id="icon-memory" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"></path>
        </symbol>
        <symbol id="icon-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 5 6v6c0 4.5 3 8 7 9 4-1 7-4.5 7-9V6l-7-3Z"></path><path d="m9 12 2 2 4-4"></path>
        </symbol>
        <symbol id="icon-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
        </symbol>
        <symbol id="icon-coin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"></circle><path d="M8 12h8M12 8v8"></path>
        </symbol>
        <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m5 12 5 5L20 7"></path>
        </symbol>
        <symbol id="icon-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </symbol>
        <symbol id="icon-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 2 21h20L12 3Z"></path><path d="M12 9v5M12 17h.01"></path>
        </symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </symbol>
        <symbol id="icon-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h6a3 3 0 0 1 3 3v14a3 3 0 0 0-3-3H4z"></path><path d="M20 4h-6a3 3 0 0 0-3 3v14a3 3 0 0 1 3-3h6z"></path>
        </symbol>
        <symbol id="icon-map" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z"></path><path d="M9 3v15M15 6v15"></path>
        </symbol>
        <symbol id="icon-sliders" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path><circle cx="9" cy="6" r="2"></circle><circle cx="15" cy="12" r="2"></circle><circle cx="8" cy="18" r="2"></circle>
        </symbol>
      </defs>
    </svg>

    <ProgressRail parts={parts} />
    <TocDrawer parts={parts} lessons={lessons} />

    <main id="main" class="book">
      <slot />
    </main>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
