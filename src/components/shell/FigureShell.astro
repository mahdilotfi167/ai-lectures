---
import Caption from './Caption.astro';
import LegacyAliases from './LegacyAliases.astro';
import { canonicalAnchor } from '../../data/curriculum-migration';

interface Props {
  id: string;
  caption: string;
  type?: string;
  describedby?: string;
  class?: string;
  suffix?: string;
}

const { id, caption, type, describedby, class: className, suffix } = Astro.props;
const anchor = canonicalAnchor(id);
---

<figure
  class:list={['figure', 'wide', className]}
  id={anchor}
  data-reveal
  data-figure={type || undefined}
  aria-describedby={describedby}
>
  <LegacyAliases anchor={anchor} />
  <div class="figure__frame">
    <slot name="visual" />
    <slot name="controls" />
  </div>
  <Caption id={id} text={caption} suffix={suffix} />
</figure>
