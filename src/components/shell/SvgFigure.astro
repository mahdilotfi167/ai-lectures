---
import FigureShell from './FigureShell.astro';

interface Props {
  id: string;
  title: string;
  desc: string;
  caption: string;
  height?: number;
  type?: string;
  interactive?: boolean;
  class?: string;
}

const { id, title, desc, caption, height = 500, type, interactive, class: className } = Astro.props;
---

<FigureShell id={id} caption={caption} type={type} describedby={`${id}-desc`} class={className}>
  <svg
    slot="visual"
    class="fig-svg"
    viewBox={`0 0 1000 ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-labelledby={`${id}-title ${id}-desc`}
    data-interactive={interactive ? 'true' : undefined}
  >
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{desc}</desc>
    <slot />
  </svg>
  <div slot="controls">
    <slot name="controls" />
  </div>
</FigureShell>
