---
import { faNum, figNum } from '../../lib/format';
import { canonicalAnchor } from '../../data/curriculum-migration';

interface Props {
  id: string;
  text: string;
  suffix?: string;
}

const { id, text, suffix } = Astro.props;
const raw = canonicalAnchor(id).replace(/^fig-/, '').replace(/-ctx$/, '');
const isPart = raw.startsWith('part-');
const label = isPart
  ? `بخش ${faNum(raw.slice(5))}`
  : `شکل ${faNum(figNum(canonicalAnchor(id)))}${suffix ? ` ${suffix}` : ''}`;
---

<figcaption class="figure__caption">
  <b>{label} — </b>{text}
</figcaption>
