---
import { faNum } from '../../lib/format';

interface Props {
  id: string;
  text: string;
  suffix?: string;
}

const { id, text, suffix } = Astro.props;
const raw = id.replace(/^fig-/, '').replace(/-ctx$/, '');
const isPart = raw.startsWith('part-');
const label = isPart
  ? `بخش ${faNum(raw.slice(5))}`
  : `شکل ${faNum(raw.replace('-', '.'))}${suffix ? ` ${suffix}` : ''}`;
---

<figcaption class="figure__caption">
  <b>{label} — </b>{text}
</figcaption>
