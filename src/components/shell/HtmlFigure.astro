---
import FigureShell from './FigureShell.astro';

interface Props {
  id: string;
  desc: string;
  caption: string;
  type?: string;
  interactive?: boolean;
  class?: string;
}

const { id, desc, caption, type, interactive, class: className } = Astro.props;
---

<FigureShell id={id} caption={caption} type={type} describedby={`${id}-desc`} class={className}>
  <div slot="visual" class="figure__html" data-interactive={interactive ? 'true' : undefined}>
    <p class="sr-only" id={`${id}-desc`}>{desc}</p>
    <slot />
  </div>
  <div slot="controls">
    <slot name="controls" />
  </div>
</FigureShell>
