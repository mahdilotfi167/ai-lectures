---
import { faNum, lessonAnchor } from '../../lib/format';
import { mapZones } from '../../data/concept-map';
import { termById } from '../../data/glossary';
import type { PartMeta, LessonMeta } from '../../data/lessons';

interface Props {
  parts: PartMeta[];
  lessons: LessonMeta[];
  idPrefix?: string;
}

const { parts, lessons, idPrefix = 'toc' } = Astro.props;
---

<nav class="toc-map" aria-label="نقشهٔ درس‌ها و مفاهیم" data-toc-map>
  {parts.map((part) => {
    const entries = lessons.filter((lesson) => lesson.part === part.part);
    const zone = mapZones.find((item) => item.part === part.part);
    return (
      <section
        class="toc-zone"
        style={`--part-color: var(--part-${part.part})`}
        aria-labelledby={`${idPrefix}-part-${part.part}`}
        data-toc-zone={part.part}
        data-search={`${part.title} ${part.promise}`}
      >
        <header class="toc-zone__head">
          <a class="toc-zone__heading" href={`#part-${part.part}`} data-toc-part={part.part}>
            <span class="toc-zone__number" aria-hidden="true">{faNum(part.part)}</span>
            <span>
              <span class="toc-zone__kicker">بخش {faNum(part.part)} · {faNum(entries.length)} درس</span>
              <span class="toc-zone__title" id={`${idPrefix}-part-${part.part}`}>{part.title}</span>
            </span>
          </a>
          <p class="toc-zone__promise">{part.promise}</p>
        </header>

        <div class="toc-zone__content">
          <ol class="toc-lesson-grid" aria-label={`درس‌های بخش ${faNum(part.part)}`}>
            {entries.map((lesson) => (
              <li data-toc-entry data-search={`${lesson.id} ${lesson.title} ${lesson.objective}`}>
                <a class="toc-lesson" href={`#${lessonAnchor(lesson.id)}`} data-toc-lesson={lesson.id}>
                  <span class="toc-lesson__number">{faNum(lesson.id)}</span>
                  <span>{lesson.title}</span>
                  <span class="toc-lesson__current">در حال خواندن</span>
                </a>
              </li>
            ))}
          </ol>

          {zone && (
            <div class="toc-concepts" data-toc-concepts>
              <p class="toc-concepts__label">مفاهیم این ناحیه</p>
              <ul class="toc-concept-grid" aria-label={`مفاهیم ${zone.label}`}>
                {zone.nodes.map((node) => (
                  <li
                    data-toc-entry
                    data-search={`${node.label} ${termById.get(node.id)?.en ?? ''} ${node.def} ${node.lesson}`}
                  >
                    <a
                      class="toc-concept"
                      href={`#${lessonAnchor(node.lesson)}`}
                      data-toc-concept={node.id}
                      title={`${node.def} — درس ${faNum(node.lesson)}`}
                      aria-label={`${node.label} — رفتن به درس ${faNum(node.lesson)}`}
                    >
                      {node.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    );
  })}
</nav>
