---
import HtmlFigure from '../shell/HtmlFigure.astro';
import { faNum } from '../../lib/format';

interface Actor {
  id: string;
  label: string;
  labelShort?: string;
  sublabel?: string;
  kind?: 'user' | 'system' | 'model' | 'tool' | 'store';
}

interface Step {
  from: string;
  to: string;
  label: string;
  mono?: boolean;
  dashed?: boolean;
  note?: string;
  tone?: 'normal' | 'danger' | 'ok';
  pause?: string;
}

interface Props {
  id: string;
  desc: string;
  caption: string;
  actors: Actor[];
  steps: Step[];
  stackAt?: number;
}

const { id, desc, caption, actors, steps } = Astro.props;

const actorSpacing = actors.length > 1 ? 700 / (actors.length - 1) : 700;
const actorX = (i: number) => (actors.length === 1 ? 500 : 850 - i * actorSpacing);
const actorIndex = new Map(actors.map((a, i) => [a.id, i]));
const actorWidth = Math.min(220, actorSpacing - 18);
const actionWidth = Math.min(320, actorSpacing - 30);
const stepY = (i: number) => 154 + i * 92;
const height = stepY(Math.max(0, steps.length - 1)) + 74;
const hasLocalActions = steps.some((step) => step.from === step.to);

const actorLabel = (id: string) => {
  const actor = actors.find((a) => a.id === id);
  return actor?.labelShort ?? actor?.label ?? id;
};

const iconFor = (kind?: string) =>
  kind === 'user' ? 'user' : kind === 'model' ? 'model' : kind === 'tool' ? 'tool' : kind === 'store' ? 'database' : 'bot';
---

<HtmlFigure id={id} desc={desc} caption={caption} type="sequence" class="fig-sequence">
  <div class="figure__desktop">
    <svg
      class="fig-svg fig-seq-svg"
      viewBox={`0 0 1000 ${height}`}
      role="img"
      aria-labelledby={`${id}-svg-title`}
      aria-describedby={`${id}-svg-desc`}
    >
      <title id={`${id}-svg-title`}>{caption}</title>
      <desc id={`${id}-svg-desc`}>{desc}</desc>

      {actors.map((actor, i) => actor.kind === 'system' && (
        <rect
          x={actorX(i) - actionWidth / 2 - 16}
          y="10"
          width={actionWidth + 32}
          height={height - 26}
          rx="12"
          class="fig-seq-lane"
        />
      ))}

      {actors.map((actor, i) => {
        const x = actorX(i);
        return (
          <g class:list={['fig-seq-actor', actor.kind === 'system' && 'is-agent']}>
            <line x1={x} y1="94" x2={x} y2={height - 26} class="fig-lifeline" />
            <rect x={x - actorWidth / 2} y="20" width={actorWidth} height="74" rx="9" class="fig-node-box" />
            <use href={`#icon-${iconFor(actor.kind)}`} x={x - actorWidth / 2 + 16} y="34" width="24" height="24" class="fig-actor-icon" />
            <text x={x + 10} y={actor.sublabel ? 49 : 64} direction="rtl" text-anchor="middle" class="fig-seq-actor__label">
              {actor.label}
            </text>
            {actor.sublabel && (
              <text x={x} y="77" direction="rtl" text-anchor="middle" class="fig-seq-actor__sub">
                {actor.sublabel}
              </text>
            )}
          </g>
        );
      })}

      {steps.map((step, i) => {
        const fromIndex = actorIndex.get(step.from) ?? 0;
        const toIndex = actorIndex.get(step.to) ?? 0;
        const x1 = actorX(fromIndex);
        const x2 = actorX(toIndex);
        const y = stepY(i);
        const isLocal = step.from === step.to;
        const pointsLeft = x2 < x1;
        const head = pointsLeft
          ? `${x2},${y} ${x2 + 9},${y - 5} ${x2 + 9},${y + 5}`
          : `${x2},${y} ${x2 - 9},${y - 5} ${x2 - 9},${y + 5}`;
        const toneClass = step.tone === 'danger' ? 'is-danger' : step.tone === 'ok' ? 'is-ok' : '';
        // A model call ends with the tool request. The next incoming message
        // starts another call, after the agent has completed its local work.
        const resumeIndex = step.pause
          ? steps.findIndex((next, nextIndex) => nextIndex > i && next.to === step.from && next.from !== next.to)
          : -1;
        const pauseStart = y + 28;
        const pauseEnd = resumeIndex > i ? stepY(resumeIndex) - 34 : y + 64;
        const pauseLabelOnLeft = x1 >= 500;
        return (
          <g class="fig-step" style={`--i: ${i}`}>
            <circle cx="978" cy={y} r="15" class="fig-seq-number" />
            <text x="978" y={y + 5} text-anchor="middle" class="fig-seq-number__text">{faNum(i + 1)}</text>
            {isLocal ? (
              <g class="fig-seq-self">
                <path
                  d={`M ${x1} ${y - 34} H ${x1 + actionWidth / 2 + 22} V ${y + 36} H ${x1}`}
                  class:list={['fig-arrow', toneClass]}
                />
                <polygon points={`${x1},${y + 36} ${x1 + 9},${y + 31} ${x1 + 9},${y + 41}`} class:list={['fig-arrow-head', toneClass]} />
                <rect
                  x={x1 - actionWidth / 2}
                  y={y - 26}
                  width={actionWidth}
                  height="54"
                  rx="8"
                  class:list={['fig-seq-action', toneClass]}
                />
                <text
                  x={x1}
                  y={step.note ? y - 3 : y + 7}
                  direction={step.mono ? 'ltr' : 'rtl'}
                  text-anchor="middle"
                  class:list={['fig-seq-message', step.mono && 'mono']}
                >
                  {step.label}
                </text>
                {step.note && (
                  <text x={x1} y={y + 18} direction="rtl" text-anchor="middle" class="fig-seq-annotation">{step.note}</text>
                )}
              </g>
            ) : (
              <g>
                <line
                  x1={x1}
                  y1={y}
                  x2={x2}
                  y2={y}
                  class:list={['fig-arrow', step.dashed && 'is-dashed', toneClass]}
                />
                <polygon points={head} class:list={['fig-arrow-head', toneClass]} />
                <text
                  x={(x1 + x2) / 2}
                  y={y - 13}
                  direction={step.mono ? 'ltr' : 'rtl'}
                  text-anchor="middle"
                  class:list={['fig-seq-message', step.mono && 'mono']}
                >
                  {step.label}
                </text>
                {step.note && (
                  <text x={(x1 + x2) / 2} y={y + 23} direction="rtl" text-anchor="middle" class="fig-seq-annotation">{step.note}</text>
                )}
              </g>
            )}
            {step.pause && (
              <g>
                <rect x={x1 - 8} y={pauseStart} width="16" height={pauseEnd - pauseStart} rx="4" class="fig-pause" />
                <text
                  x={x1 + (pauseLabelOnLeft ? -24 : 24)}
                  y={(pauseStart + pauseEnd) / 2 + 5}
                  direction="rtl"
                  text-anchor={pauseLabelOnLeft ? 'start' : 'end'}
                  class="fig-pause-label"
                >
                  {step.pause}
                </text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  </div>

  <div class="figure__mobile">
    <div class="fig-seq-actors" style={`--actors: ${actors.length}`}>
      {actors.map((actor) => (
        <div class:list={['fig-seq-actors__item', actor.kind === 'system' && 'is-agent']}>
          <strong>{actor.label}</strong>
          {actor.sublabel && <span>{actor.sublabel}</span>}
        </div>
      ))}
    </div>
    <ol class="fig-seq-mobile" role="list">
      {steps.map((step, i) => {
        const isLocal = step.from === step.to;
        return (
          <li class:list={[isLocal && 'is-local', step.tone === 'danger' && 'is-danger', step.tone === 'ok' && 'is-ok']}>
            <span class="fig-seq-mobile__number" aria-hidden="true">{faNum(i + 1)}</span>
            <div class="fig-seq-mobile__content">
              <span class="fig-seq-mobile__route">{isLocal ? `داخل ${actorLabel(step.from)}` : `از ${actorLabel(step.from)} به ${actorLabel(step.to)}`}</span>
              <span class="fig-seq-mobile__label">{step.mono ? <code class="ltr-inline">{step.label}</code> : step.label}</span>
              {step.note && <span class="fig-seq-mobile__note">{step.note}</span>}
              {step.pause && <span class="fig-seq-mobile__pause">{step.pause}</span>}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
  {hasLocalActions && <p class="fig-seq-key">از بالا به پایین بخوانید؛ کادر روی خط، کار داخلی همان بازیگر است. خط‌چین، پاسخ به پیام قبلی است.</p>}
</HtmlFigure>
