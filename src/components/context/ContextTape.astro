---
import { faNum } from '../../lib/format';
import { requireBlock } from '../../data/context/blocks';
import { compareLessonId } from '../../data/lessons';
import type { Frame } from '../../data/context/types';
import ContextBlock from './ContextBlock.astro';
import ContextText from './ContextText.astro';

interface Props {
  frame: Frame;
  lesson: string;
}

const { frame, lesson } = Astro.props;
const showTokens = compareLessonId(lesson, '3.2') >= 0;

const output = frame.output;
const jsonOutput = output ? /^[[{]/.test(output.text.trim()) : false;
const meter = frame.meter;
const used = meter?.used ?? 0;
const capacity = meter?.capacity ?? 0;
const pct = capacity > 0 ? Math.min(100, Math.round((used / capacity) * 100)) : 0;
const over = capacity > 0 ? used > capacity : false;
---

<div class="ctx-tape" data-frame={frame.id}>
  {
    frame.outside && (
      <aside class="ctx-outside" data-outside data-tone={frame.outside.tone ?? 'normal'}>
        <strong class="ctx-outside__head">بیرون از متن</strong>
        <div>
          <p class="ctx-outside__label"><ContextText text={frame.outside.label} /></p>
          {frame.outside.detail && <p class="ctx-outside__detail"><ContextText text={frame.outside.detail} /></p>}
        </div>
      </aside>
    )
  }

  <div class="ctx-tape__main">
    {frame.tapeLabel && <p class="ctx-tape__label">{frame.tapeLabel}</p>}
    <ol class="ctx-blocks" role="list" aria-label={frame.tapeLabel ?? 'متن ورودی مدل'}>
      {
        frame.blocks.map((ref) => (
          <>
            {ref.turnStart && (
              <li class="ctx-turn" role="presentation" data-turn={ref.turnStart}>
                <span>نوبت {faNum(ref.turnStart)}</span>
              </li>
            )}
            {ref.edge && (
              <li class="ctx-edge">
                <span>{ref.edge}</span>
              </li>
            )}
            <ContextBlock
              block={requireBlock(ref.id)}
              blockRef={ref}
              showMessageRole={frame.showMessageRoles}
            />
          </>
        ))
      }
      {frame.edge && (
        <li class="ctx-edge ctx-edge--end">
          <span>{frame.edge}</span>
        </li>
      )}
    </ol>

    {
      meter && (
        <div class:list={['ctx-meter', over && 'is-over']} data-meter>
          <div class="ctx-meter__bar">
            <span style={`width:${pct}%`} />
          </div>
          <p class="ctx-meter__label">
            {showTokens ? (
              <>
                ≈ {faNum(used)} از {faNum(capacity)} توکن
                {over ? ' — بیرون از لبه' : ''}
              </>
            ) : (
              'اندازهٔ متن'
            )}
          </p>
        </div>
      )
    }
  </div>

  {
    output && (
      <div class="ctx-output-wrap">
        <div class:list={['ctx-output', output.tone && `is-${output.tone}`]} data-output>
          <div class="ctx-output__head">
            <span>{output.label ?? 'ادامهٔ مدل'}</span>
            {frame.showMessageRoles && <code class="ctx-message-role" dir="ltr">assistant</code>}
          </div>
          {jsonOutput ? (
            <pre class="ctx-code ctx-code--output" dir="ltr"><code>{output.text}</code></pre>
          ) : (
            <p class="ctx-output__text">
              <ContextText text={output.text} />
            </p>
          )}
          {output.note && <p class="ctx-output__note">{output.note}</p>}
        </div>
      </div>
    )
  }
</div>
