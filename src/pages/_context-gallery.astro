---
import Book from '../layouts/Book.astro';
import ContextLens from '../components/context/ContextLens.astro';
import ContextLab from '../components/context/ContextLab.astro';
---

<Book parts={[]} lessons={[]}>
  <div class="full gallery">
    <header class="gallery__head">
      <h1>گالری لنزهای کانتکست</h1>
      <p>
        صفحهٔ توسعه برای دیدن پنج حالت لنز: گام‌به‌گام، مقایسه، ثابت، نگاشت messages و آزمایشگاه.
        این صفحه در خروجی نهایی ساخته نمی‌شود.
      </p>
    </header>

    <section class="gallery__item">
      <h2>گام‌به‌گام — ۱.۲</h2>
      <ContextLens
        id="fig-three-layers-ctx"
        lens="text-loop"
        caption="هر نوبت از پیام شما تا پاسخ دستیار است؛ پیام‌های قبلی، کانتکست پاسخ بعدی می‌شوند."
        desc="پنج گام از یک گفت‌وگوی دو نوبتی: ورودی اول، پاسخ اول، تاریخچه و پیام تازه، پاسخ دوم، و پنج پیام ذخیره‌شده. نقش‌های سیستم، کاربر و دستیار و مرز دو نوبت مشخص‌اند."
      />
    </section>

    <section class="gallery__item">
      <h2>مقایسه — ۵.۵</h2>
      <ContextLens
        id="fig-hallucination-ctx"
        lens="no-fact-fluent-guess"
        caption="اطلاعات مرتبط می‌تواند خطر پاسخ بی‌پشتوانه را کم کند."
        desc="دو مقایسه با یک پرسش: بدون مسیر فایل، نام ساختگی؛ با مسیر فایل در ورودی، نام درستِ نمونه."
      />
    </section>

    <section class="gallery__item">
      <h2>ثابت — ۱.۳</h2>
      <ContextLens
        id="fig-the-running-example-ctx"
        lens="slots"
        caption="پنج چیز لازم است؛ هر پنج، جای مشخصی در یک متن دارند."
        desc="متن دستور و پرسش، و چهار جای خالی برای نیازهای یک پاسخ خوب."
      />
    </section>

    <section class="gallery__item">
      <h2>نگاشت — ۶.۱</h2>
      <ContextLens
        id="fig-api-call-anatomy-ctx"
        lens="messages-array"
        caption="پاسخ قبلی با نقش دستیار به ورودی بعدی می‌رود؛ پاسخ تازه ابتدا خروجی است."
        desc="همان گفت‌وگوی درس ۱.۲ در سه گام: درخواست اول و پاسخ، درخواست دوم و پاسخ، و تاریخچهٔ پنج‌پیامی. گام آخر فراخوانی سوم نیست."
      />
    </section>

    <section class="gallery__item">
      <h2>آزمایشگاه — ۶.۲</h2>
      <ContextLab
        id="fig-context-engineering-ctx"
        caption="خروجی تابعی از متن ورودی است؛ کار شما ساختن آن متن است."
        desc="پنج کلید روشن و خاموش برای دستور، حافظه، ابزارها، مهارت و سند؛ پاسخ نمونه با هر تغییر عوض می‌شود."
      />
    </section>
  </div>
</Book>
